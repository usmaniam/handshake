# ---- API project (all secrets live here; never commit a real .env) ----
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_OWNER_CLIENT_ID=          # Maya (business) sandbox REST app, Payouts enabled
PAYPAL_OWNER_SECRET=
PAYPAL_WEBHOOK_ID=               # from webhook registration on the SAME app (not the client id)
PAYOUT_RAIL=paypal               # paypal | fake  (fake = never calls PayPal)
VENDOR_PAYEE_EMAIL=              # sandbox personal/business account that receives supply payouts
CONTRACTOR_PAYEE_EMAIL=          # sandbox account that receives freelancer payouts

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite    # verified live (docs/smoke-test.md); gemini-3.8-flash returned 503/504 under test
GEMINI_THINKING_LEVEL=low             # keeps verifier latency to about 1s per call
LLM_TIMEOUT_S=12                      # per-call limit; Google rejects deadlines under 10s (code never sends less)
LLM_VERIFIER=auto                     # auto (on if key set) | on | off: semantic check on digital-work deliveries
LLM_JUDGE=                            # set to "on" for the AI second opinion on payments (off by default; can only make decisions stricter)

DATABASE_URL=postgresql://...         # Neon pooled URL (normalized to postgresql+psycopg://)
DATABASE_URL_UNPOOLED=                # used by Alembic
ADMIN_TOKEN=                          # long random string; owner console + mock carrier writes
ALLOWED_ORIGINS=https://<web-project>.vercel.app
EXPIRY_GRACE_DAYS=2
AUTO_CREATE_TABLES=                   # 1 for local dev only; use `alembic upgrade head` elsewhere

# ---- Web project ----
NEXT_PUBLIC_API_BASE_URL=https://<api-project>.vercel.app
